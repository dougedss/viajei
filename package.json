{
  "name": "viajei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA offline-first para planejar e seguir roteiros de viagem de carro",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/db/vault-local.ts",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "functions:serve": "supabase functions serve",
    "remote:db-push": "set -a && . ./.env.local && set +a && supabase db push --remote",
    "remote:config-diff": "set -a && . ./.env.local && set +a && supabase config diff",
    "remote:config-push": "set -a && . ./.env.local && set +a && supabase config push",
    "remote:functions-deploy": "set -a && . ./.env.local && set +a && supabase functions deploy route-day send-notifications push-receiver --use-api --import-map supabase/functions/deno.json",
    "remote:secrets-push": "set -a && . ./.env.local && set +a && supabase secrets set ORS_API_KEY=\"$ORS_API_KEY\" VAPID_PRIVATE_KEY=\"$VAPID_PRIVATE_KEY\" VAPID_SUBJECT=\"$VAPID_SUBJECT\"",
    "geo:build": "node scripts/geo/build-data.ts",
    "db:vault-local": "node scripts/db/vault-local.ts",
    "vapid:generate": "node scripts/vapid/generate.ts",
    "lab": "node scripts/lab/run.ts",
    "lab:local": "node scripts/lab/run.ts --target local",
    "lab:setup": "set -a && . ./.env.local && set +a && node scripts/lab/setup.ts",
    "lab:remote": "gh workflow run lab.yml --repo dougedss/viajei && echo \"Laboratório disparado no GitHub Actions: gh run list --workflow lab.yml --repo dougedss/viajei\""
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@hookform/resolvers": "7.0.2",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.3",
    "canvas-confetti": "1.9.4",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "fractional-indexing": "4.0.0",
    "lucide-react": "1.68.0",
    "mediabunny": "1.62.1",
    "motion": "14.9.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "three": "0.187.0",
    "thumbhash": "0.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/shapefile": "0.6.4",
    "@types/three": "0.187.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shapefile": "0.6.6",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
