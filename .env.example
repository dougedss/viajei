# Client (podem ir no bundle). Valores locais: `pnpm db:start` imprime URL e chaves.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Edge Functions: definir com `supabase secrets set`, nunca no client (fases 3, 4 e 10)
ANTHROPIC_API_KEY=
ORS_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=            # mailto: do responsável, exigido pelo Web Push

# CLI do Supabase contra o projeto hospedado (`pnpm remote:*`): token da conta pessoal em .env.local,
# para não trocar o login das contas de cliente (decisão D10). Os scripts `remote:*` carregam este arquivo.
SUPABASE_ACCESS_TOKEN=    # token `viajei-cli`, escopo só este projeto
SUPABASE_DB_PASSWORD=     # senha do banco do projeto `viajei`; evita o prompt do `db push --remote`

# SMTP de produção (Resend, remetente viajei@reitechia.com.br). `supabase config push` lê daqui para
# preencher [remotes.production.auth.email.smtp] (decisão D11). Só envio; nunca no client.
RESEND_API_KEY=
